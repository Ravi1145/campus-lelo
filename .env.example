# ── CampusLelo — Environment Variables ──────────────────────────
# Copy this file to .env.local (local) or add the same names in your host's
# environment settings (e.g. Vercel → Project → Settings → Environment Variables).
# NEVER commit the real file. Only this template (names and placeholders) is in git.

# ── App URLs ─────────────────────────────────────────────────────
# Public site URL, no trailing slash. Used for canonicals, sitemap, schema, emails.
NEXT_PUBLIC_BASE_URL=https://campuslelo.com
NEXT_PUBLIC_SITE_URL=https://campuslelo.com
# WhatsApp number in international format, digits only
NEXT_PUBLIC_WHATSAPP_NUMBER=917753831118
# Optional: Express backend, only if you still run one (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:5000

# ── Database (Supabase) ──────────────────────────────────────────
# Required: colleges, blogs, leads and the admin panel read and write here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# Server only. Gives full database access. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ── Admin ────────────────────────────────────────────────────────
# Password for /admin
ADMIN_PASSWORD=choose_a_strong_password

# ── AI (Anthropic Claude) ────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Email (SMTP) — lead notification emails ──────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your_app_password
# Where lead emails are sent (defaults to SMTP_USER)
LEAD_EMAIL=leads@your-domain.com

# ── Security / SEO ───────────────────────────────────────────────
# Secret for /api/revalidate — pass as header: x-revalidate-secret
# Generate with: openssl rand -hex 32
REVALIDATE_SECRET=change_me_to_random_secret
# IndexNow key (Bing/Yandex instant indexing); must match the key file in /public
INDEXNOW_KEY=your_indexnow_key
# Google Search Console HTML-tag verification value (optional)
NEXT_PUBLIC_GSC_VERIFICATION=
